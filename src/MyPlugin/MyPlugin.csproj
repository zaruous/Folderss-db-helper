<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <!-- Windows가 아닌 곳(CI 등)에서도 컴파일만은 되게 한다. 실행은 Windows에서만 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- publish할 때 NuGet 패키지의 Windows용 DLL(runtimes/win/...)을 골라 출력 폴더에 펼친다. 런타임은 Folderss 것을 쓴다 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- 도움말(HTML)은 플러그인 폴더의 help\로 함께 배포한다 (도움말 메뉴·팝업의 [도움말]이 연다) -->
    <None Include="help\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 서드파티 라이선스(저장소 루트 licenses\)는 플러그인 폴더의 licenses\로 함께 배포한다 (Oracle 등은 배포물에 라이선스 사본을 넣어야 함) -->
    <None Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 이 플러그인 자체의 라이선스(MIT)도 zip 루트에 넣는다 -->
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 계약 DLL은 Folderss 본체의 것을 쓰므로 zip에 넣지 않는다 (Private=false) -->
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- 성능 모니터 이력·일일 점검 저장소(history.db). 네이티브 e_sqlite3.dll은 publish(win-x64) 때 플러그인 폴더 바로 아래에 놓이고 .deps.json으로 찾는다 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <ProjectReference Include="..\..\contract\Folderss.PluginContract\Folderss.PluginContract.csproj" Private="false" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
  </ItemGroup>

  <!--
    dotnet publish 할 때마다 publish 결과 전체(.deps.json, NuGet 패키지 DLL 포함)와 plugin.json을
    bin\<구성>\net8.0-windows\win-x64\<AssemblyName>.zip 으로 묶는다.
    Folderss는 .deps.json으로 플러그인 폴더의 DLL을 찾으므로, NuGet 패키지는 PackageReference만 추가하면 된다.
  -->
  <Target Name="PackPlugin" AfterTargets="Publish">
    <PropertyGroup>
      <PluginStage>$(IntermediateOutputPath)plugin-stage\</PluginStage>
    </PropertyGroup>
    <ItemGroup>
      <!-- publish 폴더를 통째로 묶지 않고 이번 publish 대상만 묶는다 (지운 패키지의 DLL이 남아 섞이지 않게) -->
      <PluginFiles Include="@(ResolvedFileToPublish)" Condition="'%(Extension)' != '.pdb'" />
    </ItemGroup>
    <RemoveDir Directories="$(PluginStage)" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFiles="@(PluginFiles->'$(PluginStage)%(RelativePath)')" />
    <Copy SourceFiles="plugin.json;$(PublishDir)$(TargetFileName);$(PublishDir)$(ProjectDepsFileName)" DestinationFolder="$(PluginStage)" />
    <ZipDirectory SourceDirectory="$(PluginStage)" DestinationFile="$(OutDir)$(AssemblyName).zip" Overwrite="true" />
    <Message Importance="high" Text="Folderss 플러그인: $(OutDir)$(AssemblyName).zip" />
  </Target>

</Project>
